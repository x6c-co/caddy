# Single source of truth for the custom Caddy build.
#
# Consumed by:
#   - build.sh                     (set -a; source versions.env)
#   - .github/workflows/build.yml  (grep -vE '^\s*(#|$)' >> "$GITHUB_ENV")
#
# To bump: edit a version here, commit, tag v2.11.3-a5t.N (bump N on rebuilds,
# bump the base when Caddy upgrades), and the workflow republishes the release.
#
# Keep strict KEY=value lines (no spaces around =, no quotes, no `export`) so the
# same file is valid for bash `source` and for GitHub Actions' $GITHUB_ENV.

# Toolchain. GO_VERSION must be >= the highest `go` directive across all compiled
# modules. The redis storage module (darkweak/storages/redis/caddy) requires
# go 1.26.1, which dominates Caddy's own go 1.25.0 requirement.
GO_VERSION=1.26.2
XCADDY_VERSION=v0.4.5

# Base Caddy. Must match the fleet (xcaddy build CADDY_VERSION).
CADDY_VERSION=v2.11.3

# Modules compiled in (module import paths are fixed in build.sh; bump versions here).
# - cache-handler: Souin distributed HTTP cache (registers http.handlers.cache)
# - storages/redis/caddy: Souin's Redis/Valkey storage backend (registers storages.cache.redis)
# - desec: DNS-01 ACME provider
CACHE_HANDLER_VERSION=v0.16.0
STORAGES_REDIS_VERSION=v0.0.19
DESEC_VERSION=v1.1.0
