# Single source of truth for the custom Caddy build.
#
# Consumed by:
#   - build.sh                     (set -a; source versions.env)
#   - .github/workflows/build.yml  (grep -vE '^\s*(#|$)' >> "$GITHUB_ENV")
#
# To bump: edit a version here, commit, tag v2.11.3-a5t.N (bump N on rebuilds,
# bump the base when Caddy upgrades), and the workflow republishes the release.
#
# Keep strict KEY=value lines (no spaces around =, no quotes, no `export`) so the
# same file is valid for bash `source` and for GitHub Actions' $GITHUB_ENV.

# Toolchain. GO_VERSION must be >= the highest `go` directive across all
# compiled modules (Caddy's own go 1.25.0 and coraza's 1.25.0 today).
GO_VERSION=1.26.2
XCADDY_VERSION=v0.4.5

# Base Caddy. Must match the fleet (xcaddy build CADDY_VERSION).
CADDY_VERSION=v2.11.4

# Modules compiled in (module import paths are fixed in build.sh; bump versions here).
# SLIMMED 2026-06-11 for the CDN pivot: the fleet serves static sites with
# certs pushed as files, so cache-handler, both redis storage modules and the
# desec DNS-01 provider were dropped. Only the WAF remains:
# - coraza-caddy/v2: OWASP Coraza WAF (registers http.handlers.waf; Caddyfile
#   directive coraza_waf). Embeds OWASP CRS v4 (via coraza-coreruleset).
#   Pure Go (libinjection-go), no CGO. INERT until a Caddyfile uses the
#   coraza_waf directive and loads rules.
CORAZA_VERSION=v2.5.0
